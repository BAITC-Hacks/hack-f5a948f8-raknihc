# start.sh loads .env. Direct uvicorn/CLI calls use exported environment variables.
CQ_DB_PATH=data/private/career-quest.sqlite3
CQ_AS_OF_DATE=2026-10-01
CQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CQ_SESSION_TTL_SECONDS=28800
# start.sh reads .env as literal KEY=value; existing shell values take precedence.
# Optional original dataset directory; required for a fresh database with recommendations.
# CQ_DATASET_DIR=/absolute/path/to/career_quest_dataset
CQ_HOST=127.0.0.1
CQ_PORT=8000
# Set automatically by start.sh after frontend build:
CQ_SERVE_FRONTEND=0
# Future engine secrets: only server-side CQ_ variables, never VITE_ variables.
# CQ_LLM_API_KEY=
